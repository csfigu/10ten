    "title": "10ten",
    "hooks": {
        "tenten": {
            "apparmor": "tenten.csfigu.apparmor",
            "desktop": "tenten.csfigu.desktop"
        }
    },
    "version": "0.1",
    "architecture": "$ENV{CLICK_ARCH}",
    "maintainer": "Miguel Toque <miguel.toque@gmail.com>",
    "framework": "@CLICK_FRAMEWORK@"
}
